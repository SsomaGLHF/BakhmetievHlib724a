# Програма для аналізу температурних показів за день
import sys

print("=== Аналіз температурних показів за день ===")
print("Введіть до 24 значень температур (через пробіл):")

# Введення температур користувачем
raw_temp_input = input("Температури: ").strip()

# Перевірка кількості значень
temp_tokens = raw_temp_input.split()
if not temp_tokens:
    print("[Помилка] Введено порожній рядок. Завершення роботи.")
    sys.exit()

if len(temp_tokens) > 24:
    print(f"[Помилка] Введено {len(temp_tokens)} значень. Максимально допустима кількість — 24. Завершення роботи.")
    sys.exit()

# Створення та наповнення списку для числових значень показів температур
temperatures = []
for token in temp_tokens:
    try:
        val = float(token)
    except ValueError:
        print(f"[Помилка] Значення '{token}' не є дійсним числом. Завершення роботи.")
        sys.exit()
    
    if val < -40.0 or val > 40.0:
        print(f"[Помилка] Температура {val}°C виходить за межі допустимого діапазону (-40..40). Завершення роботи.")
        sys.exit()
    
    temperatures.append(val)

# Перевірка, чи додались у список хоч якісь дані
if len(temperatures) < 2:
    print("[Помилка] Для аналізу потрібно ввести щонайменше 2 температурні показники. Завершення роботи.")
    sys.exit()

# Введення часових міток
print("\nВведіть часові мітки для кожного показу (у форматі 'година:хвилина') через пробіл:")
raw_time_input = input("Мітки часу: ").strip()
time_tokens = raw_time_input.split()

# Перевірка кількості міток
if len(time_tokens) != len(temperatures):
    print(f"[Помилка] Кількість міток часу ({len(time_tokens)}) не збігається з кількістю температур ({len(temperatures)}). Завершення роботи.")
    sys.exit()

# Перевірка формату часу
for t in time_tokens:
    parts = t.split(":")
    if len(parts) != 2:
        print(f"[Помилка] Некоректний формат мітки часу '{t}'. Очікується 'година:хвилина'. Завершення роботи.")
        sys.exit()
    
    hh_str, mm_str = parts[0], parts[1]
    if not (hh_str.isdigit() and mm_str.isdigit() and len(hh_str) == 2 and len(mm_str) == 2):
        print(f"[Помилка] Мітка часу '{t}' має містити дві цифри для годин та дві для хвилин. Завершення роботи.")
        sys.exit()
    
    hh, mm = int(hh_str), int(mm_str)
    if hh < 0 or hh > 23 or mm < 0 or mm > 59:
        print(f"[Помилка] Неприпустиме значення часу в мітці '{t}'. Години (0-23), хвилини (0-59). Завершення роботи.")
        sys.exit()

# Створення словника {час: температура}
temp_data = {}
for i in range(len(time_tokens)):
    temp_data[time_tokens[i]] = temperatures[i]

# === Обчислення характеристик через словник з даними ===
time_keys = list(temp_data.keys())
temp_values = list(temp_data.values())

total_count = len(temp_values)

# б) Середнє значення
total_sum = 0.0
for v in temp_values:
    total_sum += v
avg_temp = total_sum / total_count

# в) Мінімум та максимум
max_temp = temp_values[0]
min_temp = temp_values[0]
for v in temp_values[1:]:
    if v > max_temp:
        max_temp = v
    if v < min_temp:
        min_temp = v

# г) Кількість позитивних та негативних температур
pos_count = 0
neg_count = 0
for v in temp_values:
    if v > 0:
        pos_count += 1
    elif v < 0:
        neg_count += 1

# д) Виявлення різких змін (> 7 градусів)
sharp_changes = []
for i in range(len(time_keys) - 1):
    t1 = time_keys[i]
    t2 = time_keys[i + 1]
    v1 = temp_data[t1]
    v2 = temp_data[t2]
    
    diff = v2 - v1
    abs_diff = diff if diff >= 0 else -diff
    
    if abs_diff > 7.0:
        sharp_changes.append((t1, t2, abs_diff))

# === Виведення результатів ===
print("\n=== РЕЗУЛЬТАТ АНАЛІЗУ ===")
print("Температурні дані (час → температура):")
for t, val in temp_data.items():
    print(f"   {t} → {val:6.1f} °C")

print(f"\nЗагальна кількість вимірювань: {total_count}")
print(f"Середня температура: {avg_temp:.2f} °C")
print(f"Максимальна температура: {max_temp:.1f} °C")
print(f"Мінімальна температура: {min_temp:.1f} °C")
print(f"Кількість додатних температур: {pos_count}")
print(f"Кількість від’ємних температур: {neg_count}")

# Виведення різких змін
if sharp_changes:
    print("\n[!] Виявлено різкі зміни температури (> 7°):")
    for t1, t2, diff in sharp_changes:
        print(f"  між {t1} та {t2}: зміна на {diff:.1f}°C")
else:
    print("\n[i] Різких змін температури (> 7°) не виявлено.")

print("\n=== Кінець аналізу ===")
